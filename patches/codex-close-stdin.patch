+    /// Bridge extension: close the process pipe after queued stdin writes drain.
+    pub(crate) async fn close_stdin(
+        &self,
+        params: TerminateParams,
+    ) -> Result<TerminateResponse, JSONRPCErrorError> {
+        let processes = self.inner.processes.lock().await;
+        let Some(ProcessEntry::Running(process)) = processes.get(&params.process_id) else {
+            return Err(invalid_params("unknown or starting process".to_string()));
+        };
+        if process.tty {
+            return Err(invalid_params("PTY EOF must be sent using a terminal control character".to_string()));
+        }
+        process.session.close_stdin();
+        Ok(TerminateResponse { running: process.exit_code.is_none() })
     }
 
